# Copiez ce fichier en .env.local puis remplacez les valeurs.
# .env.local n'est jamais commité. Sur Vercel : Project → Settings → Environment Variables.

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique « anon » : sans danger côté navigateur, la sécurité repose sur les policies RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# --- Coordonnées affichées sur le site --------------------------------------
# Numéro WhatsApp qui reçoit les demandes de devis, au format international.
# Espaces, « + » et tirets sont acceptés (ex. +212 6 12 34 56 78).
NEXT_PUBLIC_WHATSAPP_NUMBER=+212 6 00 00 00 00
# Téléphone affiché tel quel et utilisé pour les liens « Appeler ».
NEXT_PUBLIC_PHONE=+212 6 00 00 00 00
NEXT_PUBLIC_CONTACT_EMAIL=contact@exemple.ma
NEXT_PUBLIC_ADDRESS=Casablanca, Maroc — livraison nationale
NEXT_PUBLIC_HOURS=Lun – Sam · 8h30 – 18h30

# URL publique du site, sans slash final (métadonnées, sitemap, partage).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
